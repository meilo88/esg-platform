# ============================================================
# 可持续发展报告指标平台 - 环境变量配置模板
# 部署上线时请复制为 .env 文件（或在云平台环境变量面板配置）
# ============================================================

# 运行环境 (production 禁用热重载与调试接口)
ENV=production
PORT=8000

# 管理后台登录密码 (默认 suibe123，线上部署也可通过此变量覆盖)
ADMIN_PASSWORD=suibe123

# 平台全局大模型引擎选择: gemini 或 openai (兼容 DeepSeek / 通义千问等)
LLM_PROVIDER=gemini

# 方式一：Google Gemini 配置
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 方式二：OpenAI 兼容接口配置 (例如 DeepSeek: https://api.deepseek.com/v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 跨域白名单 (默认 *，如需绑定固定域名可填 https://your-domain.com)
CORS_ORIGINS=*
